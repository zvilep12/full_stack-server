PORT=3000

# Database Configurations
DB_DIALECT=sqlite
DB_STORAGE=./database.db

# Security & Authentication (JWT Session Signing)
JWT_SECRET=your_jwt_secret_key_here

# NodeMailer & 2FA Email Configuration (Gmail SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password_here

# SMTP Server Settings (Defaults configured for Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

